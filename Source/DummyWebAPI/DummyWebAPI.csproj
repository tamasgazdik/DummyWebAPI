<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c130e2eb-f4cb-46ac-a9ab-c8b15904b681</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DummyWebAPI.Service\DummyWebAPI.Service.csproj" />
  </ItemGroup>

  <!-- Docker configuration. For some reason launching 'Container (Dockerfile)' profile doesn't work as expected -->
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfilePath>..\..\Dockerfile</DockerfilePath>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

</Project>
