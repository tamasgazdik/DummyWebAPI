{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NumberOfMotorcyclesToStartWith": 10,
  "Kestrel": {
    "Endpoints": {
      "HTTP": {
        "Url": "http://+:5000"
      },
      "HTTPS": {
        "Certificate": {
          "Path": "/https/aspnetapp.pfx"
        },
        "Url": "https://+:5001"
      }
    }
  }
}
